{
  "env": {
    "browser": true,
    "webextensions": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "eqeqeq": ["error", "always"],
    "curly": "warn",
    "no-console": "off"
  }
}
